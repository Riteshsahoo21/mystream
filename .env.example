# RitzlaPlay Environment Configuration

# Google Cloud Translation Basic (v2). Restrict browser keys by HTTP referrer.
VITE_GOOGLE_TRANSLATE_API_KEY=your_google_translate_browser_key

# VidSrc provides the complete playable movie, series, and episode inventory.
VITE_STREAM_API_URL=https://vsembed.ru

# Keyless metadata enrichment for posters, plots, genres, cast, and episodes.
VITE_METADATA_API_URL=https://v3-cinemeta.strem.io
